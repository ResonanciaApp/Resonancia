{
  "expo": {
    "name": "Resonancia",
    "slug": "mobile",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "resonancia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B060F"
    },
    "androidStatusBar": {
      "hidden": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.resonancia.app",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "RESONANCIA usa el micrófono para grabar tu Voz Interior y mensajes de voz en los chats.",
        "NSPhotoLibraryUsageDescription": "RESONANCIA accede a tus fotos para que puedas elegir tu foto de perfil y compartir imágenes en los mensajes.",
        "NSPhotoLibraryAddUsageDescription": "RESONANCIA guarda imágenes en tu galería cuando las descargás.",
        "NSCameraUsageDescription": "RESONANCIA usa la cámara para que puedas sacarte una foto de perfil.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.resonancia.app",
      "backgroundColor": "#1B060F",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libfbjni.so",
                "**/libfolly_runtime.so",
                "**/libglog.so",
                "**/libreact_nativemodule_core.so",
                "**/libjsi.so"
              ],
              "exclude": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF",
                "META-INF/MANIFEST.MF",
                "META-INF/*.kotlin_module",
                "META-INF/AL2.0",
                "META-INF/LGPL2.1"
              ]
            }
          },
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ],
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "RESONANCIA accede a tus fotos para que puedas elegir tu foto de perfil y compartir imágenes en los mensajes.",
          "cameraPermission": "RESONANCIA usa la cámara para que puedas sacarte una foto de perfil."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "RESONANCIA usa el micrófono para grabar tu Voz Interior y mensajes de voz en los chats."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C69B4F"
        }
      ],
      "expo-video",
      "react-native-audio-api",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "181736c1-cb71-4763-8d71-0b4ae2ce30a1"
      }
    },
    "owner": "casadelcuenco",
    "updates": {
      "url": "https://u.expo.dev/181736c1-cb71-4763-8d71-0b4ae2ce30a1",
      "enabled": false
    }
  }
}
